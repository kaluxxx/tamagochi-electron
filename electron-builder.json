{
  "appId": "com.tamagotchi.electron",
  "productName": "Tamagotchi Electron",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "prisma/schema.prisma",
    "prisma/migrations/**/*"
  ],
  "asarUnpack": [
    "node_modules/.prisma/**/*"
  ],
  "win": {
    "target": ["portable"],
    "icon": "build/icon.ico"
  }
}
