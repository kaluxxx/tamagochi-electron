{
  "appId": "com.tamagotchi.electron",
  "productName": "Tamagotchi Electron",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "prisma/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/client/**/*"
  ],
  "extraResources": [
    {
      "from": "prisma",
      "to": "prisma",
      "filter": ["schema.prisma", "migrations/**/*"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/.prisma/**/*"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icon.ico"
  }
}
