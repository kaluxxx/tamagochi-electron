{
  "appId": "com.tamagotchi.electron",
  "productName": "Tamagotchi Electron",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "src/generated/prisma/**/*"
  ],
  "extraResources": [
    {
      "from": "prisma/prisma/tamagotchi.db",
      "to": "db/tamagotchi.db"
    }
  ],
  "win": {
    "target": ["portable"],
    "icon": "build/icon.ico"
  }
}
