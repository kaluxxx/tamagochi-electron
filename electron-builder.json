{
  "appId": "com.tamagotchi.electron",
  "productName": "Tamagotchi Electron",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "prisma/schema.prisma",
    "prisma/migrations/**/*"
  ],
  "extraResources": [
    {
      "from": "node_modules/.prisma",
      "to": "prisma-client/.prisma"
    },
    {
      "from": "node_modules/@prisma/client",
      "to": "prisma-client/@prisma/client"
    }
  ],
  "win": {
    "target": ["portable"],
    "icon": "build/icon.ico"
  }
}
